# ProofDesk / Orbit demo configuration.
# Copy to .env.local for local development.

# Demo mode runs deterministically without model, embedding, or email keys.
DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage: auto uses Postgres when DATABASE_URL is set, otherwise the file adapter.
STORAGE_DRIVER=auto
PROOFDESK_DATA_DIR=.data
# DATABASE_URL=postgresql://proofdesk:proofdesk@localhost:5432/proofdesk

# Optional Anthropic model. Ignored while DEMO_MODE=true.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# No vendor price list was fetched on 24 November 2026.
# Leave these unset to record no estimated model price.
# If you set them, cost is (input tokens × input rate + output tokens × output rate) / 1,000,000.
# Deterministic demo answers are always $0. Preview-sink email is $0.
# MODEL_INPUT_USD_PER_MILLION=
# MODEL_OUTPUT_USD_PER_MILLION=

# Optional Voyage embeddings. PostgreSQL FTS is the required baseline.
EMBEDDING_PROVIDER=none
# VOYAGE_API_KEY=
# EMBEDDING_MODEL=voyage-3

# Optional Resend delivery. Demo mode always uses the in-app email sink.
# RESEND_API_KEY=
EMAIL_FROM="Orbit Demo <support@example.com>"
# DEMO_EMAIL_TO=you@example.com

# Protects the inactivity cron endpoint in production.
# CRON_SECRET=
# RATE_LIMIT_SECRET=